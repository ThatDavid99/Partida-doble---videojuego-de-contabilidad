  m_Script: {fileID: 11500000, guid: 82b8e72d30bbd8345aa0450783171f78, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: NPC
        icon: {fileID: 3170606959719978654, guid: 61120f4a9b37ec44c86dfd508d1a65cf, type: 3}
      line: Hola, bienvenido a la isla. Aqui podras encontrar diferentes entornos...
    - character:
        name: Player
        icon: {fileID: -6183007600839754392, guid: 61120f4a9b37ec44c86dfd508d1a65cf, type: 3}
      line: Hola, soy Jeison, gusto en conocerte.
    - character:
        name: NPC
        icon: {fileID: -1800681657418604919, guid: 61120f4a9b37ec44c86dfd508d1a65cf, type: 3}
      line: Tendras que viajar a las diferentes islas para lograr tus objetivos.
    - character:
        name: NPC
        icon: {fileID: -5118499719815636493, guid: 61120f4a9b37ec44c86dfd508d1a65cf, type: 3}
      line: En cada una de las islas, encontraras variedad de retos...
    - character:
        name: NPC
        icon: {fileID: -5118499719815636493, guid: 61120f4a9b37ec44c86dfd508d1a65cf, type: 3}
      line: "Tendras que superar cada uno de ellos para cumplir tu meta. \xA1Suerte!"
    - character:
        name: NPC
        icon: {fileID: -5118499719815636493, guid: 61120f4a9b37ec44c86dfd508d1a65cf, type: 3}
      line: Usa el bote para trasladarte de una isla a otra con facilidad.
    - character:
        name: Player
        icon: {fileID: -6183007600839754392, guid: 61120f4a9b37ec44c86dfd508d1a65cf, type: 3}
      line: Gracias.
  dialoguePanel: {fileID: 1412749359}
  interactionPrompt: {fileID: 3862233044793965542, guid: ef2d7b3937a968d4ea68bec193c6fb47, type: 3}
