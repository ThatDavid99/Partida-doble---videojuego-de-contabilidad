--- !u!114 &1587858309
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1587858305}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 82b8e72d30bbd8345aa0450783171f78, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: npc2
        icon: {fileID: 3254334229483698624, guid: 72e0bceab862a634b9d1d3c0fc180c83, type: 3}
      line: Veo que lograste aprobar el primer reto, pero conmigo no sera facil.
    - character:
        name: Player
        icon: {fileID: -4567771349213767063, guid: 61120f4a9b37ec44c86dfd508d1a65cf, type: 3}
      line: Mmmmm...
    - character:
        name: NPC2
        icon: {fileID: -6384036047920486352, guid: 72e0bceab862a634b9d1d3c0fc180c83, type: 3}
      line: Si quieres obtener el premio, primero tienes que hacer algo por mi...
    - character:
        name: NPC2
        icon: {fileID: -6384036047920486352, guid: 72e0bceab862a634b9d1d3c0fc180c83, type: 3}
      line: Ve al laberinto, encuentra los 5 objetos perdidos y traemelos.
    - character:
        name: NPC2
        icon: {fileID: 3254334229483698624, guid: 72e0bceab862a634b9d1d3c0fc180c83, type: 3}
      line: Una vez lo hagas, demostraras que eres lo suficientemente...
    - character:
        name: NPC2
        icon: {fileID: -6384036047920486352, guid: 72e0bceab862a634b9d1d3c0fc180c83, type: 3}
      line: Valeinte para continuar con esta aventura.
    - character:
        name: Player
        icon: {fileID: -8191090600096703253, guid: 61120f4a9b37ec44c86dfd508d1a65cf, type: 3}
      line: "\xBFEl laberinto?"
    - character:
        name: NPC2
        icon: {fileID: 3254334229483698624, guid: 72e0bceab862a634b9d1d3c0fc180c83, type: 3}
      line: "Navega con direccIon al este y allI lo encontraras. \xA1Date prisa!"
    - character:
        name: Player
        icon: {fileID: -6183007600839754392, guid: 61120f4a9b37ec44c86dfd508d1a65cf, type: 3}
      line: "\xA1Alla voy!"
  dialoguePanel: {fileID: 1412749359}
  interactionPrompt: {fileID: 3862233044793965542, guid: ef2d7b3937a968d4ea68bec193c6fb47, type: 3}
